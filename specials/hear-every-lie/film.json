{
  "title": "What If You Could Hear Every Lie?",
  "shots": [
    {"id": "1", "kind": "table", "props": [{"t": "bell", "x": 620, "y": 640, "s": 1.3}, {"t": "key", "x": 1500, "y": 480, "toX": 1120, "toY": 560, "rot": 20, "label": "218"}, {"t": "hand", "x": 1660, "y": 560, "toX": 1300, "toY": 620, "rot": -80, "cuff": "#2f5c8f"}], "hold": 0.4, "lines": [{"who": "man", "text": "Lovely stay. Really.", "ding": 1}]},
    {"id": "2", "kind": "wide", "set": "lobby", "desk": true, "cast": [{"who": "you", "x": 960, "pose": "desk", "face": "bored"}, {"who": "man", "x": 480, "s": 1.05, "pose": "idle", "face": "smile"}], "lines": [{"who": "man", "text": "And I didn't take the towels.", "ding": 1}, {"who": "you", "text": "Enjoy the towels, sir."}]},

    {"id": "3", "kind": "keyrack", "lit": false, "bed": "calm", "lines": [{"who": "narrator", "text": "The average person tells one or two lies a day."}]},
    {"id": "4", "kind": "keyrack", "wave": true, "lines": [{"who": "narrator", "text": "Most people catch a lie about half the time."}]},
    {"id": "4b", "kind": "big", "text": "54%", "small": "BARELY BETTER THAN A COIN", "lines": [{"who": "narrator", "text": "Fifty-four percent. Barely better than a coin."}]},
    {"id": "5", "kind": "big", "text": "100%", "color": "#d9a93f", "lines": [{"who": "narrator", "text": "You? One hundred."}]},
    {"id": "5b", "kind": "close", "set": "lobby", "who": "you", "face": "bored", "mood": "night", "lines": [{"who": "narrator", "text": "You've got no idea why. Every lie, out loud, in your head. A small, polite bell."}]},
    {"id": "6", "kind": "close", "set": "lobby", "who": "you", "face": "smug", "mood": "night", "x": 760, "lines": [{"who": "narrator", "text": "So what's it like, hearing every lie? Great. And terrible. Sometimes in the same sentence."}]},

    {"id": "7", "kind": "table", "tag": "PERK", "props": [{"t": "card", "x": 700, "y": 480, "text": "K", "rot": -8}, {"t": "card", "x": 860, "y": 500, "text": "K", "red": true, "rot": 5}, {"t": "card", "x": 1100, "y": 470, "back": true, "rot": 3}, {"t": "card", "x": 1260, "y": 490, "back": true, "rot": -5}, {"t": "hand", "x": 1560, "y": 860, "rot": -35, "cuff": "#7c1f33", "toY": 800}], "lines": [{"who": "narrator", "text": "Nobody beats you at poker."}, {"who": "otis", "text": "Busted flush. I owe you nine dollars."}, {"who": "narrator", "text": "Otis pays."}]},
    {"id": "8", "kind": "wide", "set": "lobby", "mood": "warm", "desk": true, "tag": "PERK", "cast": [{"who": "you", "x": 960, "pose": "desk", "face": "smug"}, {"who": "man", "look": "inspector", "x": 450, "s": 1.05, "pose": "point", "face": "smile"}], "lines": [{"who": "man", "text": "I'm with the fire marshal's office.", "ding": 1}, {"who": "you", "text": "Sir, you're with a vending machine company."}]},
    {"id": "9", "kind": "map", "tag": "PERK", "dots": 26, "moveCount": 1, "pills": [{"text": "CHECKED OUT, HE SAYS", "x": 620, "y": 330, "color": "#d9a93f"}, {"text": "STILL IN THE ROOM", "x": 1300, "y": 630}], "lines": [{"who": "narrator", "text": "You know who's skipping the bill before they reach the elevator."}]},

    {"id": "10", "kind": "split", "tag": "COST", "bed": "none", "left": {"kind": "close", "set": "lobby", "mood": "cost", "who": "you", "x": 470, "y": 1760, "s": 3.3, "pose": "phone", "face": "neutral"}, "right": {"kind": "close", "set": "kitchen", "mood": "cost", "who": "mom", "x": 1420, "y": 1760, "s": 3.3, "pose": "phone", "face": "smile", "strip": false, "flip": true}, "lines": [{"who": "mom", "text": "Money's fine, sweetie. Don't worry about me.", "ding": 1}, {"who": "narrator", "text": "You can't un-hear that."}]},
    {"id": "11", "kind": "wide", "set": "diner", "mood": "cost", "tag": "COST", "cast": [{"who": "you", "x": 640, "pose": "sit", "face": "sad"}, {"who": "date", "x": 1290, "pose": "sit", "face": "smile", "flip": true}], "lines": [{"who": "date", "text": "This is fun. I'm having fun.", "ding": 1}, {"who": "narrator", "text": "You pay. You walk home."}]},
    {"id": "12", "kind": "wide", "set": "party", "mood": "cost", "tag": "COST", "cast": [{"who": "you", "x": 420, "face": "neutral", "s": 1.05}, {"who": "date", "x": 730, "face": "smile", "flip": true}, {"who": "man", "look": "coworker", "x": 1210, "face": "smile", "flip": true}, {"who": "guest2", "look": "date", "x": 1500, "face": "happy", "flip": true}], "lines": [{"who": "date", "text": "Love the haircut.", "ding": 1}, {"who": "man", "text": "Great to have you.", "ding": 1}, {"who": "guest2", "text": "We should hang out.", "ding": 2}, {"who": "narrator", "text": "A whole room, ringing."}]},
    {"id": "13", "kind": "close", "set": "lobby", "mood": "cost", "who": "you", "x": 1120, "tag": "COST", "face": "sad", "lines": [{"who": "narrator", "text": "Here's what nobody tells you. Polite is mostly lying. Kind is mostly lying."}]},
    {"id": "13b", "kind": "close", "set": "lobby", "mood": "cost", "who": "you", "tag": "COST", "face": "tired", "push": [1.04, 1.13], "origin": [960, 440], "lines": [{"who": "narrator", "text": "You can't get a compliment you believe."}]},
    {"id": "14", "kind": "diagram", "label": "THE BELL NEVER STOPS", "lines": [{"who": "narrator", "text": "So you stopped asking people things. Questions are how you get hurt."}]},
    {"id": "15", "kind": "insert", "obj": "note", "text": "NEVER|LIE.", "bg": "#3b2a1e", "lines": [{"who": "narrator", "text": "And you made one rule. You never lie. Not once. You know what it sounds like."}]},

    {"id": "16", "kind": "insert", "obj": "door", "bg": "#2d3e3f", "lines": [{"who": "narrator", "text": "And then there's Otis."}]},
    {"id": "16b", "kind": "insert", "obj": "jacket", "bg": "#22302f", "lines": [{"who": "narrator", "text": "Forty years of carrying other people's bags."}]},
    {"id": "17", "kind": "table", "props": [{"t": "button", "x": 960, "y": 480, "s": 1.3}, {"t": "hand", "x": 1320, "y": 750, "toX": 1240, "toY": 690, "rot": -50, "cuff": "#7c1f33"}], "hold": 1.2, "lines": []},
    {"id": "18", "kind": "wide", "set": "staff", "mood": "warm", "cast": [{"who": "otis", "x": 980, "pose": "sitmug", "face": "bored"}, {"who": "you", "x": 1560, "pose": "sitmug", "face": "smile", "flip": true}], "lines": [{"who": "otis", "text": "This coffee's terrible."}, {"who": "narrator", "text": "That's why you like him."}]},
    {"id": "19", "kind": "close", "set": "staff", "mood": "warm", "who": "otis", "face": "tired", "x": 860, "stripColor": "#5a3d2a", "lines": [{"who": "otis", "text": "You're a strange kid."}, {"who": "narrator", "text": "Three years. Not one bell. He's the only person in your life who has never rung."}]},
    {"id": "20", "kind": "close", "set": "staff", "mood": "warm", "who": "otis", "face": "smile", "x": 1080, "stripColor": "#5a3d2a", "lines": [{"who": "otis", "text": "But you're all right."}]},
    {"id": "20b", "kind": "close", "set": "staff", "mood": "warm", "who": "you", "face": "smile", "stripColor": "#5a3d2a", "lines": [{"who": "narrator", "text": "You've never been so glad to hear nothing."}]},

    {"id": "21", "kind": "wide", "set": "lobby", "desk": true, "cast": [{"who": "you", "x": 960, "pose": "desk"}, {"who": "quill", "x": 90, "toX": 460, "s": 1.05, "face": "neutral"}], "lines": [{"who": "quill", "text": "One night. Room four twelve. Business."}]},
    {"id": "21b", "kind": "table", "dark": true, "props": [{"t": "key", "x": 760, "y": 400, "toX": 1040, "toY": 500, "rot": 18}, {"t": "hand", "x": 560, "y": 520, "toX": 820, "toY": 590, "rot": 75}], "lines": [{"who": "narrator", "text": "Nothing unusual. You hand her the key."}]},
    {"id": "22", "kind": "wide", "set": "lobby", "mood": "day", "cast": [{"who": "vane", "x": 640, "s": 1.15, "face": "smile", "pose": "point"}, {"who": "inspector", "x": 980, "flip": true, "pose": "idle"}, {"who": "you", "x": 1540, "s": 0.8, "pose": "idle", "face": "neutral", "flip": true}], "lines": [{"who": "vane", "text": "The alarms? Tested this morning.", "ding": 1}]},
    {"id": "23", "kind": "close", "set": "lobby", "mood": "day", "who": "vane", "face": "smile", "lines": [{"who": "vane", "text": "Fully up to code.", "ding": 2}]},
    {"id": "23b", "kind": "wide", "set": "basement", "mood": "night", "bed": "tense", "cast": [{"who": "you", "x": 760, "s": 1.05, "pose": "point", "face": "neutral"}], "hold": 0.9, "lines": []},
    {"id": "24", "kind": "panel", "bed": "tense", "lines": [{"who": "narrator", "text": "It's cheaper not to fix it. And nobody ever asks."}]},
    {"id": "25", "kind": "wide", "set": "office", "mood": "day", "bed": "tense", "cast": [{"who": "you", "x": 450, "pose": "idle", "face": "angry"}, {"who": "vane", "x": 1010, "s": 1.15, "pose": "shrug", "face": "smile", "flip": true}], "lines": [{"who": "you", "text": "The alarm's off."}, {"who": "vane", "text": "Don't be silly. I'd never put my guests at risk.", "ding": 1}]},
    {"id": "25b", "kind": "close", "set": "office", "mood": "day", "bed": "tense", "who": "vane", "face": "smug", "stripColor": "#3d291c", "push": [1, 1.1], "origin": [960, 440], "lines": [{"who": "vane", "text": "You've still got a job, kid. Do you want to keep it?"}], "after": 1.0},

    {"id": "26", "kind": "big", "text": "3:12 AM", "bed": "tense", "size": 230, "lines": [], "hold": 1.3},
    {"id": "26b", "kind": "wide", "set": "laundry", "mood": "fire", "bed": "tense", "smoke": 0.8, "cast": [], "sfx": [{"n": "rumble", "v": 0.5}], "hold": 2.2, "lines": []},
    {"id": "27", "kind": "split", "bed": "tense", "smoke": 0.45, "sfx": [{"n": "click", "at": 1.0, "v": 0.9}, {"n": "click", "at": 1.5, "v": 0.9}, {"n": "click", "at": 2.0, "v": 0.9}], "left": {"kind": "wide", "set": "stairs", "mood": "fire", "cast": []}, "right": {"kind": "wide", "set": "lobby", "mood": "night", "desk": true, "cast": [{"who": "you", "x": 1400, "pose": "bang", "face": "shock", "flip": true}]}, "hold": 3.0, "lines": []},
    {"id": "28", "kind": "phone", "bed": "tense", "contact": "EMERGENCY DISPATCH", "messages": [{"from": "them", "text": "Crews on the way.|Hotel Larkspur.", "line": 0}, {"from": "them", "text": "NINE MINUTES.", "line": 0}], "lines": [{"who": "narrator", "text": "Two hundred and twelve guests. Nine minutes. No alarm."}]},
    {"id": "29", "kind": "wide", "set": "corridor", "mood": "fire", "bed": "tense", "smoke": 0.6, "sfx": [{"n": "knock", "at": 0.1, "v": 0.8}, {"n": "knock", "at": 0.6, "v": 0.8}], "cast": [{"who": "you", "x": 620, "s": 1.1, "pose": "bang", "face": "shock"}, {"who": "guest1", "look": "robe", "x": 980, "s": 1.1, "flip": true, "face": "bored"}], "lines": [{"who": "guest1", "text": "Is this a drill?"}, {"who": "you", "text": "It's a real fire!"}, {"who": "guest1", "text": "Right. Sure, kid."}]},
    {"id": "29b", "kind": "wide", "set": "corridor", "mood": "fire", "bed": "tense", "smoke": 0.7, "sfx": [{"n": "knock", "at": 0.1, "v": 0.8}], "cast": [{"who": "you", "x": 1350, "s": 1.1, "pose": "shrug", "face": "angry", "flip": true}, {"who": "guest2", "look": "robe2", "x": 1000, "s": 1.1, "face": "bored"}], "lines": [{"who": "guest2", "text": "Call the front desk."}, {"who": "you", "text": "I am the front desk!"}]},
    {"id": "30", "kind": "map", "bed": "tense", "dots": 60, "moveCount": 3, "clock": "6:40", "lines": [{"who": "narrator", "text": "You've told the truth your whole life. Nobody's listening."}]},
    {"id": "31", "kind": "wide", "push": [1.04, 1.1], "origin": [760, 640], "set": "stairs", "mood": "fire", "bed": "tense", "smoke": 0.7, "cast": [{"who": "otis", "x": 980, "y": 610, "s": 1.05, "pose": "point", "flip": true, "face": "neutral"}, {"who": "you", "x": 540, "y": 790, "s": 1.05, "face": "shock"}], "lines": [{"who": "otis", "text": "You've got the P A. So talk to them in a language they understand."}]},
    {"id": "32", "kind": "close", "set": "lobby", "mood": "fire", "bed": "none", "who": "you", "face": "neutral", "pose": "mic", "mic": true, "note": "NEVER|LIE.", "push": [1, 1.14], "origin": [960, 440], "hold": 2.2, "lines": []},
    {"id": "33", "kind": "close", "set": "lobby", "mood": "fire", "bed": "none", "who": "you", "face": "happy", "pose": "mic", "mic": true, "note": "NEVER|LIE.", "push": [1.14, 1.2], "origin": [960, 440], "lines": [{"who": "you", "text": "Good morning, guests! Free breakfast on the front lawn, in the next three minutes only. First come. Pancakes.", "ding": 1, "big": true}], "after": 1.4},
    {"id": "34", "kind": "wide", "set": "corridor", "mood": "fire", "bed": "calm", "smoke": 0.45, "cast": [{"who": "guest1", "look": "robe", "x": 200, "toX": 1300, "s": 1.1, "face": "shock"}, {"who": "guest2", "look": "robe2", "x": 20, "toX": 1120, "s": 1.05, "face": "happy"}, {"who": "man", "look": "robe", "x": -190, "toX": 900, "s": 1.1, "face": "shock"}, {"who": "date", "look": "robe2", "x": -360, "toX": 720, "s": 1, "face": "happy"}], "lines": [{"who": "guest1", "text": "Did he say pancakes?"}]},
    {"id": "34b", "kind": "map", "bed": "calm", "dots": 90, "pour": true, "pills": [{"text": "212 GUESTS", "x": 960, "y": 415, "color": "#d9a93f"}], "hold": 3.4, "lines": []},
    {"id": "35", "kind": "wide", "push": [1.08, 1.14], "origin": [960, 640], "set": "lawn", "mood": "dawn", "lights": true, "sfx": [{"n": "siren", "v": 0.34}], "cast": [{"who": "extra", "look": "robe", "x": 320, "face": "angry", "y": 950}, {"who": "x2", "look": "robe2", "x": 520, "face": "angry", "y": 970, "s": 1.05}, {"who": "x3", "look": "robe", "x": 760, "face": "shock", "y": 990}, {"who": "x4", "look": "robe2", "x": 1130, "face": "angry", "y": 955}, {"who": "x5", "look": "robe", "x": 1380, "face": "sad", "y": 990, "s": 1.05}, {"who": "x6", "look": "robe", "x": 1620, "face": "angry", "y": 960}], "lines": [{"who": "narrator", "text": "Two hundred and twelve people, in robes, on a lawn. Furious, and alive."}]},

    {"id": "36", "kind": "close", "set": "lawn", "mood": "dawn", "lights": true, "who": "you", "face": "neutral", "strip": false, "lines": [{"who": "narrator", "text": "Every guest. Then you count one more."}]},
    {"id": "36b", "kind": "close", "set": "lawn", "mood": "dawn", "who": "you", "face": "shock", "strip": false, "x": 740, "bed": "tense", "lines": [{"who": "narrator", "text": "Otis went back up, to check the third floor."}]},
    {"id": "37", "kind": "wide", "push": [1.08, 1.14], "origin": [700, 640], "set": "lawn", "mood": "dawn", "bed": "tense", "lights": true, "stretcher": [370, 810], "cast": [{"who": "ff1", "look": "firefighter", "x": 560, "toX": 1000, "y": 930, "s": 1.1, "face": "neutral"}, {"who": "ff2", "look": "firefighter", "x": 180, "toX": 620, "y": 930, "s": 1.1, "face": "neutral"}, {"who": "you", "x": 40, "toX": 340, "y": 960, "s": 1.05, "face": "shock"}], "hold": 3.0, "lines": []},
    {"id": "38", "kind": "close", "set": "lawn", "mood": "dawn", "who": "otis", "face": "tired", "strip": false, "bed": "none", "lines": [{"who": "otis", "text": "I'm not scared.", "ding": 1}], "after": 1.0},
    {"id": "38b", "kind": "close", "set": "lawn", "mood": "dawn", "who": "you", "face": "sad", "strip": false, "bed": "none", "lines": [{"who": "narrator", "text": "Three years. The first one."}], "after": 0.5},
    {"id": "39", "kind": "close", "set": "lawn", "mood": "dawn", "who": "you", "face": "sad", "x": 1020, "strip": false, "bed": "calm", "lines": [{"who": "you", "text": "You're going to be fine.", "ding": 1}], "after": 0.8},
    {"id": "40", "kind": "close", "set": "lawn", "mood": "dawn", "who": "otis", "face": "closed", "strip": false, "bed": "calm", "push": [1, 1.1], "origin": [960, 440], "lines": [{"who": "otis", "text": "You're a terrible liar."}], "after": 2.2},

    {"id": "41", "kind": "news", "cast": [{"who": "vane", "x": 960, "s": 1.9, "face": "smile"}], "lines": [{"who": "vane", "text": "I had no idea.", "ding": 1}], "after": 0.8},
    {"id": "42", "kind": "wide", "set": "hospital", "mood": "warm", "cast": [{"who": "otis", "x": 700, "y": 836, "pose": "sitmug", "face": "bored", "noShadow": true}, {"who": "you", "x": 1210, "pose": "idle", "face": "smile", "flip": true}], "lines": [{"who": "otis", "text": "This coffee's terrible."}, {"who": "narrator", "text": "You laugh. Right on time."}]},
    {"id": "43", "kind": "phone", "contact": "MOM", "screen": "#f5ecd8", "messages": [{"from": "them", "text": "Money's fine, sweetie.", "line": 0}, {"from": "me", "text": "I know, Mom.|I love you too.", "line": 1}], "lines": [{"who": "mom", "text": "Money's fine, sweetie.", "ding": 1}, {"who": "you", "text": "I know, Mom. I love you too."}, {"who": "narrator", "text": "Some bells, you just let ring."}]},

    {"id": "44", "kind": "wide", "set": "curb", "mood": "dawn", "bed": "tense", "cast": [{"who": "you", "x": 570, "pose": "idle", "face": "neutral"}, {"who": "quill", "x": 1040, "s": 1.05, "face": "smug", "flip": true}], "lines": [{"who": "quill", "text": "Clever. The pancakes."}]},
    {"id": "45", "kind": "close", "set": "curb", "mood": "dawn", "who": "quill", "s": 3, "y": 1760, "face": "smug", "bed": "tense", "strip": false, "lines": [{"who": "quill", "text": "I'm a dentist from Ohio.", "after": 1.2}, {"who": "quill", "text": "I was asleep during the fire.", "after": 1.2}, {"who": "quill", "text": "I've never told a lie in my life."}], "after": 1.3},
    {"id": "46", "kind": "close", "set": "curb", "mood": "dawn", "who": "you", "face": "shock", "bed": "none", "strip": false, "push": [1, 1.16], "origin": [960, 440], "lines": [{"who": "narrator", "text": "No bell. Not one. You've never heard that much silence."}], "after": 1.2},
    {"id": "47", "kind": "table", "dark": true, "bed": "tense", "props": [{"t": "key", "x": 1200, "y": 300, "toX": 960, "toY": 480, "rot": 22, "s": 1.5}, {"t": "hand", "x": 1460, "y": 360, "toX": 1320, "toY": 500, "rot": -68, "cuff": "#1f4f57"}], "lines": [{"who": "quill", "text": "Your hearing is very good. Mine's better. Check-out's at noon."}], "after": 1.4},

    {"id": "48", "kind": "end", "bed": "calm", "lines": [{"who": "narrator", "text": "Would you want it? Comment one word. Bell, or silence."}], "after": 3.0}
  ]
}
